# Application Settings
APP_NAME=moveo
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Databases (Database-Per-Service isolation)
POSTGRES_USER=moveo
POSTGRES_PASSWORD=moveo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL_AUTH=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_auth
DATABASE_URL_INVENTORY=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_inventory
DATABASE_URL_BOOKING=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_booking
DATABASE_URL_PAYMENT=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_payment
DATABASE_URL_NOTIFICATION=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_notification
DATABASE_URL_REVIEW=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_review
DATABASE_URL_LOYALTY=postgresql+asyncpg://moveo:moveo@localhost:5432/moveo_loyalty

# Redis Cache & Distributed Lock
REDIS_URL=redis://localhost:6379/0

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Authentication / JWT
JWT_SECRET_KEY=super-secret-key-change-me-in-production-12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]
